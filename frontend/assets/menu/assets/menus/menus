<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Menus &amp; Drink Options — The Mobile Mixery</title>
<meta name="description" content="Seasonal cocktail menus and the full drink book from The Mobile Mixery — mobile bartending in Riverside, CA. Filter 32 cocktails by season, spirit, flavour and colour." />
<meta name="theme-color" content="#FFFBF6" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,600;6..96,700&family=Dancing+Script:wght@600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="./assets/styles.css" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='14' fill='%23C26A4A'/%3E%3C/svg%3E" />
</head>
<body>

<header class="topbar">
  <a class="brand" href="https://themobilemixeryca.com/">
    <span class="brand-dot" aria-hidden="true"></span>
    <span class="brand-name">The Mobile Mixery</span>
  </a>
  <nav class="topnav">
    <a href="#menus">Menus</a>
    <a href="#drinks">Drink Options</a>
    <a href="#inquiry">Inquire</a>
    <a class="topnav-back" href="https://themobilemixeryca.com/">Main site</a>
  </nav>
</header>

<main>

  <!-- ─────────────────────────  INTRO  ───────────────────────── -->
  <section class="intro">
    <p class="script">craft cocktails, your venue</p>
    <h1>Menus &amp; Drink Options</h1>
    <p class="intro-lede">
      Every lineup we pour, in one place. Browse the menu boards we've designed for
      past events, then dig through the full book — filter by season, spirit, flavour
      or colour to find the mix that fits your party.
    </p>
    <p class="intro-meta">Riverside &bull; Rowland Heights &bull; SoCal</p>
  </section>

  <!-- ─────────────────────  MENU GALLERY  ───────────────────── -->
  <section id="menus" class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="script">real boards, real bookings</p>
          <h2>Menus We've Poured</h2>
          <p class="lede">
            Every event gets its own menu board, designed around the theme and the
            drinks. Here's a look at what we've built — tap any board to see it full size.
          </p>
        </div>
        <p class="section-count"><span id="menu-count"></span></p>
      </div>

      <div class="gallery" id="gallery"><!-- rendered --></div>
    </div>
  </section>

  <!-- ────────────────────  DRINK OPTIONS  ──────────────────── -->
  <section id="drinks" class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="script accent">the full book</p>
          <h2>Every Drink We Pour</h2>
          <p class="lede">
            Tap the keywords to narrow it down — stack as many as you like.
            Filters work separately from the menus above.
          </p>
        </div>
        <p class="section-count"><span id="drink-count"></span></p>
      </div>

      <form class="filters" id="filters" role="search" aria-label="Filter drink options">
        <div class="search-row">
          <label class="search">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M16.5 16.5 21 21"/></svg>
            <input type="search" id="q" placeholder="Search a drink, spirit or ingredient…" autocomplete="off" aria-label="Search drinks" />
          </label>
          <button type="button" class="clear" id="clear" hidden>Clear all</button>
        </div>
        <div id="chip-groups"><!-- rendered --></div>
      </form>

      <p class="result-count" id="count" role="status" aria-live="polite"></p>

      <div class="grid" id="grid"><!-- rendered --></div>

      <div class="empty" id="empty" hidden>
        <svg viewBox="0 0 64 64" aria-hidden="true">
          <path d="M14 14h36l-14 18v16l-8 4V32z" />
        </svg>
        <h3>Nothing matches that mix</h3>
        <p>Try loosening a filter — or clear them and start again.</p>
        <button type="button" class="btn" id="empty-clear">Clear all filters</button>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────  INQUIRY  ───────────────────────── -->
  <section id="inquiry" class="inquiry">
    <div class="wrap inquiry-inner">

      <div class="inquiry-intro">
        <p class="script">let's pour</p>
        <h2>Found your vibe?</h2>
        <p class="lede">
          You show us your vibe, we design it. Send over your date and we'll build
          the menu around it — board and all, like the ones above.
        </p>
        <ul class="inquiry-notes">
          <li>Custom menu design included with every booking</li>
          <li>Riverside, Rowland Heights and across SoCal</li>
          <li>We reply by email, usually within a day</li>
        </ul>
      </div>

      <!-- Handled by Netlify Forms; submitted over fetch by app.js. -->
      <form
        class="inquiry-form"
        id="inquiry-form"
        name="mobile-mixery-inquiry"
        method="POST"
        action="/menu/"
        data-netlify="true"
        netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="mobile-mixery-inquiry" />
        <input type="hidden" name="subject" value="New menu inquiry from %{formName}" />
        <p class="hp" aria-hidden="true">
          <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="field-row">
          <label class="field">
            <span>Name</span>
            <input name="name" required autocomplete="name" placeholder="Arianna" />
          </label>
          <label class="field">
            <span>Email</span>
            <input name="email" type="email" required autocomplete="email" placeholder="you@email.com" />
          </label>
        </div>

        <div class="field-row">
          <label class="field">
            <span>Event date</span>
            <input name="date" type="date" />
          </label>
          <label class="field">
            <span>Location</span>
            <input name="location" autocomplete="address-level2" placeholder="Riverside, CA" />
          </label>
        </div>

        <label class="field">
          <span>Theme vibe</span>
          <select name="theme">
            <option>Not sure yet — help me pick</option>
            <option>Birthday</option>
            <option>Wedding</option>
            <option>Bridal or baby shower</option>
            <option>Quinceañera or Sweet 16</option>
            <option>Halloween</option>
            <option>Tropical</option>
            <option>Graduation</option>
            <option>Other — custom</option>
          </select>
        </label>

        <label class="field">
          <span>Tell us your vibe</span>
          <textarea name="message" rows="4" placeholder="Colours, drinks you love, guest count, anything you saw above…"></textarea>
        </label>

        <button type="submit" class="btn btn-solid">Send inquiry</button>
        <p class="form-status" id="form-status" role="status" aria-live="polite" hidden></p>
      </form>

      <div class="inquiry-done" id="inquiry-done" tabindex="-1" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5 9.5 18 20 6.5" /></svg>
        <h3>Got it — thank you</h3>
        <p>We've got your details and we'll be in touch by email shortly.</p>
      </div>

    </div>
  </section>

</main>

<footer class="footer">
  <p class="foot-brand">The Mobile Mixery</p>
  <p class="foot-meta">@the_mobile_mixery_ &bull; themobilemixeryca.com &bull; Riverside to Rowland Heights</p>
</footer>

<!-- ─────────────────────────  LIGHTBOX  ───────────────────────── -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Menu board viewer" hidden>
  <div class="lb-stage">
    <img id="lb-img" alt="" />
    <div class="lb-caption">
      <h3 id="lb-title"></h3>
      <p id="lb-pours"></p>
      <p class="lb-pos" id="lb-pos"></p>
    </div>
  </div>
  <button type="button" class="lb-btn lb-close" id="lb-close" aria-label="Close viewer">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>
  <button type="button" class="lb-btn lb-prev" id="lb-prev" aria-label="Previous menu">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
  </button>
  <button type="button" class="lb-btn lb-next" id="lb-next" aria-label="Next menu">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
  </button>
</div>

<script type="module" src="./assets/app.js"></script>
</body>
</html> 
